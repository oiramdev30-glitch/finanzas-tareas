{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "theme/**/*.ts",
    "theme/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "web",
    "dist",
    "supabase",
    ".expo"
  ]
}
